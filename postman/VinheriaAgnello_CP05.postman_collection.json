          "name": "6.1 Remover dispositivo",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": {
              "raw": "http://{{url}}:4041/iot/devices/{{deviceId}}",
              "protocol": "http",
              "host": [
                "{{url}}"
              ],
              "port": "4041",
              "path": [
                "iot",
                "devices",
                "{{deviceId}}"
              ]
            },
            "description": "Remove o dispositivo do IoT Agent (use so se precisar provisionar de novo)."
          }
        },
        {
          "name": "6.2 Remover entidade do Orion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": {
              "raw": "http://{{url}}:1026/v2/entities/{{entityId}}",
              "protocol": "http",
              "host": [
                "{{url}}"
              ],
              "port": "1026",
              "path": [
                "v2",
                "entities",
                "{{entityId}}"
              ]
            },
            "description": "Remove a entidade de contexto."
          }
        },
        {
          "name": "6.3 Remover assinatura (cole o id)",
          "request": {
            "method": "DELETE",
