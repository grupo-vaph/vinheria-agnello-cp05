            "method": "GET",
            "header": [
              {
                "key": "fiware-service",
                "value": "{{service}}"
              },
              {
                "key": "fiware-servicepath",
                "value": "{{servicepath}}"
              }
            ],
            "url": {
              "raw": "http://{{url}}:8666/STH/v1/contextEntities/type/{{entityType}}/id/{{entityId}}/attributes/temperature?lastN=30",
              "protocol": "http",
              "host": [
                "{{url}}"
              ],
              "port": "8666",
              "path": [
                "STH",
                "v1",
                "contextEntities",
                "type",
                "{{entityType}}",
                "id",
                "{{entityId}}",
                "attributes",
                "temperature"
