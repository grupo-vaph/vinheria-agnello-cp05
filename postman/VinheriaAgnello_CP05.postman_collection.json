                  "value": "2026-12-31T23:59:59.999Z"
                }
              ]
            },
            "description": "Agregado por hora (sum e samples por intervalo: media = sum/samples). Tambem aceita aggrMethod=max, min, sum2 e aggrPeriod=day, month."
